#!/usr/bin/env -S dbox -f

# https://github.com/varlabz/dbox
# dbox - lightweight Docker sandbox manager
# Config file format (shell variables):
#   DBOX_CONTAINER=<name>    # container name (optional).
#   DBOX_IMAGE=<image>       # Docker image to use (optional).
#   DBOX_DIR=<path>          # host path mounted as working directory (optional).
#   DBOX_MOUNT=("host_path:container_path" ...) # optional extra mounts (optional)
#   DBOX_PARAM=              # optional extra Docker run parameters (optional).
#   DBOX_ENV=(KEY=val ...)   # optional extra environment variables (optional)
#   DBOX_INIT=("cmd1" ...)   # optional commands to run after container creation (optional)
#   DBOX_EXEC=<cmd>          # default command for `dbox -e` with no args (optional)

DBOX_IMAGE="node:26-bookworm-slim"
DBOX_MOUNT=(
    "$HOME/.config/mimocode:/root/.config/mimocode:rw"
)
DBOX_INIT=(
    "apt-get update && apt-get install -y curl git bash"
    "npm install -g npm@latest"
    "npm install -g @mimo-ai/cli --allow-scripts=@mimo-ai/cli"
)
DBOX_EXEC="mimo --dangerously-skip-permissions"
